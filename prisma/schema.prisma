generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Wine {
  id             String        @id @default(cuid())
  name           String
  producer       String?
  color          String?
  region         String?
  appellation    String?
  grapeVarieties String?
  country        String?       @default("France")
  description    String?
  notes          String?
  imageUrl       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  vintages WineVintage[]
}

model WineVintage {
  id            String   @id @default(cuid())
  wineId        String
  vintage       Int?
  quantity      Int      @default(1)
  volume        Int      @default(75)
  purchasePrice Float?
  marketPrice   Float?
  drinkFrom     Int?
  drinkUntil    Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wine  Wine             @relation(fields: [wineId], references: [id], onDelete: Cascade)
  slots WineVintageSlot[]
}

model WineVintageSlot {
  id        String   @id @default(cuid())
  vintageId String
  rackId    String
  rackRow   Int
  rackCol   Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  vintage WineVintage @relation(fields: [vintageId], references: [id], onDelete: Cascade)
  rack    Rack        @relation(fields: [rackId], references: [id])
}

model Rack {
  id    String            @id @default(cuid())
  name  String
  rows  Int               @default(6)
  cols  Int               @default(12)
  slots WineVintageSlot[]
}

model WineHistory {
  id          String   @id @default(cuid())
  action      String   // "bu" | "retiré"
  wineName    String
  producer    String?
  vintage     Int?
  color       String?
  appellation String?
  region      String?
  country     String?
  volume      Int      @default(75)
  quantity    Int      @default(1)
  rating      Float?
  imageUrl    String?
  consumedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
}
